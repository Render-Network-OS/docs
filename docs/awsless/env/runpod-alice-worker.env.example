# RunPod Alice worker env contract for the AWSless 555stream rail.
# Source references:
# - 555-bot/k8s/base/deployment.yaml
# - 555-bot/Dockerfile
# - 555stream/.env.example capture/agent variables
#
# Never commit filled secrets. Store values in RunPod secrets, not in image
# layers or repository files.

# Runtime
NODE_ENV=production
PORT=3000
MILAIDY_PORT=3000
MILAIDY_API_BIND=0.0.0.0
DISPLAY=:99
ALICE_FULL_DUTY_MODE=true

# Persistent state. Mount these onto a RunPod network volume if state must
# survive pod replacement.
MILAIDY_STATE_DIR=/home/node/.milaidy
MILAIDY_HOME=/home/node/.milaidy
MILAIDY_BROWSER_STATE_PATH=/home/node/.milaidy/browser
MILAIDY_BROWSER_HOME=/home/node/.milaidy/browser/home
PGLITE_DATA_DIR=/home/node/.milaidy/workspace/.eliza/.elizadb
MILAIDY_PGLITE_RECOVERY=true
CACHE_DIR=/home/node/.eliza/cache
MODELS_DIR=/home/node/.eliza/models

# Auth. Value "0" means auth is enabled, matching the current K8s manifest.
MILAIDY_AUTH_DISABLED=0
MILAIDY_API_TOKEN=replace-with-secret
ELIZA_API_TOKEN=replace-with-secret
MILAIDY_CREDENTIALS_MASTER_KEY=replace-with-secret

# LLM providers
ANTHROPIC_API_KEY=replace-with-secret
OPENAI_API_KEY=

# Browser/render safety
SHELL_ALLOWED_DIRECTORY=/app/milaidy
CAPTURE_ENABLE_SOFTWARE_WEBGL=true
CAPTURE_ENABLE_UNSAFE_SWIFTSHADER=false
CAPTURE_TRUSTED_WEBGL_HOSTS=alice.rndrntwrk.com,stream.rndrntwrk.com,railway-control-plane.example.up.railway.app,localhost,127.0.0.1

# 555stream bridge
STREAM555_BASE_URL=https://railway-control-plane.example.up.railway.app
STREAM555_AGENT_TOKEN=replace-with-secret
STREAM555_AGENT_API_KEY=replace-with-secret
STREAM555_REQUIRE_APPROVALS=false
STREAM555_CONTROL_PLUGIN_ENABLED=true
STREAM_PLUGIN_ENABLED=true
STREAM555_DEFAULT_SESSION_ID=alice

# Destination sync. Set enabled flags/keys only for the named evidence window.
STREAM555_DEST_SYNC_ON_GO_LIVE=true
STREAM555_DEST_TWITCH_ENABLED=false
STREAM555_DEST_TWITCH_RTMP_URL=
STREAM555_DEST_TWITCH_STREAM_KEY=
STREAM555_DEST_KICK_ENABLED=false
STREAM555_DEST_KICK_RTMP_URL=
STREAM555_DEST_KICK_STREAM_KEY=
STREAM555_DEST_YOUTUBE_ENABLED=false
STREAM555_DEST_YOUTUBE_RTMP_URL=
STREAM555_DEST_YOUTUBE_STREAM_KEY=
STREAM555_DEST_PUMPFUN_ENABLED=false
STREAM555_DEST_PUMPFUN_RTMP_URL=
STREAM555_DEST_PUMPFUN_STREAM_KEY=
STREAM555_DEST_X_ENABLED=false
STREAM555_DEST_X_RTMP_URL=
STREAM555_DEST_X_STREAM_KEY=
STREAM555_DEST_FACEBOOK_ENABLED=false
STREAM555_DEST_FACEBOOK_RTMP_URL=
STREAM555_DEST_FACEBOOK_STREAM_KEY=
STREAM555_DEST_CUSTOM_ENABLED=false
STREAM555_DEST_CUSTOM_RTMP_URL=
STREAM555_DEST_CUSTOM_STREAM_KEY=

# Trusted operators/admins. Keep empty until the production identity source is
# explicitly selected.
MILAIDY_TRUSTED_ADMIN_IDS=
MILAIDY_TRUSTED_ADMIN_DISCORD_IDS=
MILAIDY_TRUSTED_ADMIN_TELEGRAM_IDS=
MILAIDY_TRUSTED_ADMIN_WHATSAPP_IDS=
TRUSTED_ADMIN_IDS=
TRUSTED_ADMIN_DISCORD_IDS=
TRUSTED_ADMIN_TELEGRAM_IDS=
TRUSTED_ADMIN_WHATSAPP_IDS=

# Optional connectors/social.
TWITTER_USERNAME=
TWITTER_PASSWORD=
TWITTER_EMAIL=
TWITTER_2FA_SECRET=
TWITTER_COOKIES_FULL=
DISCORD_API_TOKEN=
DISCORD_APPLICATION_ID=
TELEGRAM_BOT_TOKEN=
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_USER_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=
WHATSAPP_DM_POLICY=
WHATSAPP_GROUP_POLICY=

# Optional 555/SW4P plugins. Leave disabled unless they are part of the test.
FIVE55_API_BEARER_TOKEN=
FIVE55_API_KEY=
FIVE55_API_SIGNING_SECRET=
FIVE55_HTTP_TIMEOUT_MS=10000
FIVE55_HTTP_RETRIES=3
FIVE55_HTTP_RETRY_BASE_MS=750
FIVE55_HTTP_MAX_RESPONSE_CHARS=65536
SW4P_API_BEARER_TOKEN=
SW4P_API_KEY=
SW4P_API_SIGNING_SECRET=
SWAP_PLUGIN_ENABLED=false
FIVE55_GAMES_PLUGIN_ENABLED=false
FIVE55_SCORE_CAPTURE_PLUGIN_ENABLED=false
FIVE55_LEADERBOARD_PLUGIN_ENABLED=false
FIVE55_QUESTS_PLUGIN_ENABLED=false
FIVE55_BATTLES_PLUGIN_ENABLED=false
FIVE55_ADMIN_PLUGIN_ENABLED=false
FIVE55_SOCIAL_PLUGIN_ENABLED=false
FIVE55_REWARDS_PLUGIN_ENABLED=false

# Optional wallet/chain providers.
ALCHEMY_API_KEY=
EVM_PRIVATE_KEY=
SOLANA_PRIVATE_KEY=

