# Railway control-plane env contract for the AWSless 555stream rail.
# Source references:
# - 555stream/.env.example
# - 555stream/services/control-plane/.env.example
# - 555stream/k8s/base/control-plane-deployment.yaml
#
# Never commit filled secrets. Store values in Railway environment variables or
# synced secret tooling only.

# Runtime
NODE_ENV=production
PORT=3000
LOG_LEVEL=info
FRONTEND_URL=https://stream.rndrntwrk.com
INTERNAL_FRONTEND_URL=https://stream.rndrntwrk.com

# Managed state
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
REDIS_URL=redis://HOST:PORT

# Core auth and encryption
JWT_SECRET=replace-with-secret
ADMIN_API_KEY=replace-with-secret
CSRF_SECRET=replace-with-secret
ENCRYPTION_KEY=replace-with-32-byte-secret
REQUIRE_NONCE=true

# Agent/API bridge
AGENT_API_ENABLED=true
AGENT_API_TOKEN=replace-with-secret
STREAM_DISABLE_OUTPUTS=true
STREAM555_AVATAR_DISTRIBUTOR=cloudflare

# Alice worker bridge. These are provider-neutral placeholders for the
# RunPod-hosted Alice worker once the worker URL is known.
STREAM555_AGENT_BASE_URL=https://alice-worker.example.runpod.net
STREAM555_AGENT_TOKEN=replace-with-secret
STREAM555_AGENT_API_KEY=replace-with-secret
STREAM555_REQUIRE_APPROVALS=false

# Cloudflare Stream / media authority
CLOUDFLARE_ACCOUNT_ID=replace-with-account-id
CLOUDFLARE_API_TOKEN=replace-with-secret
CLOUDFLARE_STREAM_TOKEN=replace-with-secret
CLOUDFLARE_STREAM_DOMAIN=customer-example.cloudflarestream.com
CLOUDFLARE_WEBHOOK_SECRET=replace-with-secret
CLOUDFLARE_NOTIFICATIONS_WEBHOOK_SECRET=replace-with-secret
BUILTIN_AD_MEDIA_BASE_URL=https://assets.rndrntwrk.com/library/public/ads

# TURN / RealtimeKit
CLOUDFLARE_TURN_ID=replace-with-turn-id
CLOUDFLARE_TURN_KEY=replace-with-secret
TURN_HOST=turn.cloudflare.com
TURN_TTL_SECONDS=3600
TURN_AUTH_SECRET=replace-with-secret
SFU_PROVIDER=cloudflare
REALTIMEKIT_ENABLED=true
REALTIMEKIT_ORG_ID=replace-with-org-id
REALTIMEKIT_API_KEY=replace-with-secret
REALTIMEKIT_WEBHOOK_SECRET=replace-with-secret

# Edge data service. Keep read flags false until D1 parity is proven.
D1_SERVICE_URL=https://555stream-db-service.rndrntwrk.workers.dev
D1_SERVICE_TOKEN=replace-with-secret
D1_DUAL_WRITE=false
D1_PRIMARY=false
D1_READ_USERS=false
D1_READ_PROFILES=false
D1_READ_PLATFORMS=false
D1_READ_SESSIONS=false
D1_READ_OUTPUTS=false
D1_READ_RECORDINGS=false
D1_READ_ASSETS=false
D1_READ_SOURCES=false
D1_READ_RADIO=false
D1_READ_TRACKS=false

# Worker/service URLs
IMAGE_SERVICE_URL=https://555stream-image-service.rndrntwrk.workers.dev
CONTINUITY_DEFAULT_HLS_URLS=

# Default channel metadata. Secrets/keys live in provider secret stores, not here.
DEFAULT_TWITCH_CHANNEL=rndrntwrk
DEFAULT_KICK_CHANNEL=rndrntwrk
DEFAULT_PUMP_TOKEN=

# Recording retention
RECORDING_RETENTION_MODE=ttl_only
RECORDING_TTL_MINUTES=5
RECORDING_RETENTION_CHECK_INTERVAL_SECONDS=60

# Billing/economics: disabled for first AWSless smoke unless explicitly needed.
BILLING_RECONCILIATION_ENABLED=false
BILLING_PROVIDER_INVOICE_MODE=disabled
BILLING_PROVIDER_INVOICE_ALLOW_HTTP=false
BILLING_PROVIDER_INVOICE_ALLOW_UNSAFE_HOSTS=false
BILLING_PROVIDER_INVOICE_SIGNATURE_SECRET=
WEEKLY_SETTLEMENT_ENABLED=false
ECONOMICS_DUAL_WRITE_ENABLED=false
SW4P_FEE_INGEST_ENABLED=false
REVENUE_POLICY_DB_ENABLED=false
PLATFORM_DISTRIBUTION_EXECUTOR_ENABLED=false

# Optional integrations. Leave blank unless the named feature is in the evidence window.
BRANDFETCH_API_KEY=
ANTHROPIC_API_KEY=
IDEOGRAM_API_KEY=

