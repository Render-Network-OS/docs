# Cloudflare Workers env contract for the AWSless 555stream rail.
# Source references:
# - 555stream/workers/*/wrangler.toml
# - 555stream/ECOSYSTEM_ENV_DEPLOY_SECRET_MATRIX.md
#
# This file is a redacted checklist. Put secrets into `wrangler secret` or the
# Cloudflare dashboard. Keep binding IDs in environment-specific wrangler config.

# Shared
CLOUDFLARE_ACCOUNT_ID=replace-with-account-id
ORIGIN_URL=https://railway-control-plane.example.up.railway.app
ORIGIN_RESOLVE_OVERRIDE=
ALLOWED_ORIGINS=https://stream.rndrntwrk.com,https://alice.rndrntwrk.com
LOG_LEVEL=info

# api-router Worker
API_ROUTER_ROUTE=https://stream.rndrntwrk.com/api/*
JWT_ISSUER=555stream
JWT_AUDIENCE=555stream-api
JWT_SECRET=replace-with-secret
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
CONFIG_KV_NAMESPACE_ID=replace-with-kv-id
ICE_CACHE_KV_NAMESPACE_ID=replace-with-kv-id
RATE_LIMIT_KV_NAMESPACE_ID=replace-with-kv-id
BROADCAST_DO_BINDING=BroadcastDO
SESSION_DO_BINDING=SessionDO
ANALYTICS_DO_BINDING=AnalyticsDO
D1_DATABASE_NAME=555stream-db
D1_DATABASE_ID=replace-with-d1-id

# db-service Worker
DB_SERVICE_ROUTE=https://555stream-db-service.rndrntwrk.workers.dev/*
DB_SERVICE_TOKEN=replace-with-secret
DB_SERVICE_D1_DATABASE_NAME=555stream-db
DB_SERVICE_D1_DATABASE_ID=replace-with-d1-id

# image-service Worker
IMAGE_SERVICE_ROUTE=https://555stream-image-service.rndrntwrk.workers.dev/*
IMAGES_BUCKET=555stream-images
IMAGE_CACHE_KV_NAMESPACE_ID=replace-with-kv-id
DEFAULT_QUALITY=85
DEFAULT_FORMAT=auto
MAX_WIDTH=1920
MAX_HEIGHT=1080
CACHE_TTL_SECONDS=86400

# vod-archiver Worker
VOD_ARCHIVER_ROUTE=https://555stream-vod-archiver.rndrntwrk.workers.dev/*
VOD_BUCKET=555stream-vod
ARCHIVE_JOBS_KV_NAMESPACE_ID=replace-with-kv-id
ARCHIVER_AUTH_TOKEN=replace-with-secret
ARCHIVE_AFTER_DAYS=7
DELETE_FROM_STREAM_DAYS=30
BATCH_SIZE=10

# durable-objects Worker
DURABLE_OBJECTS_ROUTE=https://555stream-do.rndrntwrk.workers.dev/*
ADMIN_DEBUG_TOKEN=replace-with-secret
DURABLE_OBJECTS_D1_DATABASE_NAME=555stream-db
DURABLE_OBJECTS_D1_DATABASE_ID=replace-with-d1-id

# slate-injector Worker
SLATE_INJECTOR_ROUTE=https://stream.rndrntwrk.com/*
CLOUDFLARE_STREAM_DOMAIN=customer-example.cloudflarestream.com
SLATE_VIDEO_ID=slate-please-stand-by
GAP_THRESHOLD_SECONDS=6

# Cloudflare Stream / TURN / Realtime
CLOUDFLARE_STREAM_TOKEN=replace-with-secret
CLOUDFLARE_WEBHOOK_SECRET=replace-with-secret
CLOUDFLARE_TURN_ID=replace-with-turn-id
CLOUDFLARE_TURN_KEY=replace-with-secret
REALTIMEKIT_ORG_ID=replace-with-org-id
REALTIMEKIT_API_KEY=replace-with-secret
REALTIMEKIT_WEBHOOK_SECRET=replace-with-secret

# Optional Tunnel for provider-private origin reachability.
CLOUDFLARE_TUNNEL_ID=
CLOUDFLARE_TUNNEL_TOKEN=
