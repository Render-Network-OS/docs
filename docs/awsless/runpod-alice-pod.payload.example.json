{
  "name": "alice-awsless-bootstrap",
  "cloudType": "SECURE",
  "computeType": "CPU",
  "cpuFlavorIds": ["cpu3g", "cpu3c"],
  "cpuFlavorPriority": "availability",
  "containerDiskInGb": 20,
  "imageName": "node:22-bookworm-slim",
  "dockerEntrypoint": [],
  "dockerStartCmd": ["bash", "-lc", "replace-with-generated-bootstrap-command"],
  "env": {
    "BOOTSTRAP_PORT": "3999",
    "BOOTSTRAP_TOKEN": "replace-with-generated-bootstrap-token",
    "BOOTSTRAP_WORKSPACE": "/workspace",
    "NODE_ENV": "production",
    "PORT": "3000",
    "MILAIDY_PORT": "3000",
    "MILAIDY_API_BIND": "0.0.0.0",
    "DISPLAY": ":99",
    "ALICE_FULL_DUTY_MODE": "true",
    "MILAIDY_STATE_DIR": "/home/node/.milaidy",
    "MILAIDY_HOME": "/home/node/.milaidy",
    "MILAIDY_BROWSER_STATE_PATH": "/home/node/.milaidy/browser",
    "MILAIDY_BROWSER_HOME": "/home/node/.milaidy/browser/home",
    "PGLITE_DATA_DIR": "/home/node/.milaidy/workspace/.eliza/.elizadb",
    "MILAIDY_PGLITE_RECOVERY": "true",
    "CACHE_DIR": "/home/node/.eliza/cache",
    "MODELS_DIR": "/home/node/.eliza/models",
    "MILAIDY_AUTH_DISABLED": "0",
    "MILAIDY_API_TOKEN": "replace-with-secret",
    "ELIZA_API_TOKEN": "replace-with-secret",
    "MILAIDY_CREDENTIALS_MASTER_KEY": "replace-with-secret",
    "ANTHROPIC_API_KEY": "replace-with-secret",
    "OPENAI_API_KEY": "",
    "SHELL_ALLOWED_DIRECTORY": "/app/milaidy",
    "CAPTURE_ENABLE_SOFTWARE_WEBGL": "true",
    "CAPTURE_ENABLE_UNSAFE_SWIFTSHADER": "false",
    "CAPTURE_TRUSTED_WEBGL_HOSTS": "alice.rndrntwrk.com,stream.rndrntwrk.com,localhost,127.0.0.1",
    "STREAM555_BASE_URL": "https://replace-with-railway-control-plane.up.railway.app",
    "STREAM555_AGENT_TOKEN": "replace-with-secret",
    "STREAM555_AGENT_API_KEY": "replace-with-secret",
    "STREAM555_REQUIRE_APPROVALS": "false",
    "STREAM555_CONTROL_PLUGIN_ENABLED": "true",
    "STREAM_PLUGIN_ENABLED": "true",
    "STREAM555_DEFAULT_SESSION_ID": "alice",
    "STREAM555_DEST_SYNC_ON_GO_LIVE": "false",
    "STREAM555_DEST_TWITCH_ENABLED": "false",
    "STREAM555_DEST_KICK_ENABLED": "false",
    "STREAM555_DEST_YOUTUBE_ENABLED": "false",
    "STREAM555_DEST_PUMPFUN_ENABLED": "false",
    "STREAM555_DEST_X_ENABLED": "false",
    "STREAM555_DEST_FACEBOOK_ENABLED": "false",
    "STREAM555_DEST_CUSTOM_ENABLED": "false"
  },
  "ports": ["3000/http", "3999/http"],
  "supportPublicIp": true,
  "volumeInGb": 40,
  "volumeMountPath": "/workspace",
  "locked": false,
  "interruptible": true
}
